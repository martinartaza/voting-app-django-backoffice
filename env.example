# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_NAME=challenger_db
DB_USER=challenger_user
DB_PASSWORD=challenger_password
DB_HOST=db
DB_PORT=5432

# ========================================
# DJANGO SUPERUSER CONFIGURATION
# ========================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_COMPANY=Default Company

# ========================================
# DJANGO SETTINGS
# ========================================
# Set to False in production
DJANGO_DEBUG=True

# Generate a strong secret key for production
DJANGO_SECRET_KEY=your-secret-key-here

# Custom domain (for production)
CUSTOM_DOMAIN=

# Cloud Run Service URL (auto-set by Cloud Run)
CLOUD_RUN_SERVICE_URL=

# ========================================
# RESET DATABASE (FIRST DEPLOY ONLY)
# ========================================
# Set to true ONLY for the first deploy to Cloud Run
# This will drop all existing tables from the previous project
# IMPORTANT: Remove this variable after first successful deploy!
RESET_DATABASE=false

# ========================================
# EMAIL CONFIGURATION (RESEND)
# ========================================
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Voting System

# ========================================
# GITHUB OAUTH CONFIGURATION
# ========================================
CLIENT_ID_GITHUB=your-github-client-id-here
CLIENT_SECRET_GITHUB=your-github-client-secret-here

# ========================================
# PRODUCTION CONFIGURATION
# ========================================
PRODUCTION_DOMAIN=django.sebastianartaza.com

# ========================================
# PRODUCTION ENVIRONMENT EXAMPLE
# ========================================
# For Cloud Run production deployment, use these settings:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=your-strong-production-secret-key
# CUSTOM_DOMAIN=django.sebastianartaza.com
# RESET_DATABASE=true  (ONLY for first deploy, then remove it!)
# DB_HOST=your-cloud-sql-instance-connection-name
# DB_NAME=your-production-db-name
# DB_USER=your-production-db-user
# DB_PASSWORD=your-production-db-password 